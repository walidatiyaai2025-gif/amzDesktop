<Window x:Class="Walka.Amazon.ConnectionTester.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WALKA Amazon Analyzer" Height="820" Width="1360" MinHeight="720" MinWidth="1100" WindowStartupLocation="CenterScreen">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="WALKA Amazon Analyzer" FontSize="27" FontWeight="SemiBold"/>
            <TextBlock Text="Production SP-API · read-only collection · credentials remain in memory only" Foreground="DimGray" Margin="0,4,0,0"/>
        </StackPanel>

        <Border Grid.Row="1" BorderBrush="#D7DCE2" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,10,0"><TextBlock Text="LWA Client ID" FontWeight="SemiBold"/><TextBox x:Name="ClientIdBox" Margin="0,6,0,0" Height="30"/></StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,10,0"><TextBlock Text="LWA Client Secret" FontWeight="SemiBold"/><PasswordBox x:Name="ClientSecretBox" Margin="0,6,0,0" Height="30"/></StackPanel>
                <StackPanel Grid.Column="2"><TextBlock Text="Refresh Token" FontWeight="SemiBold"/><PasswordBox x:Name="RefreshTokenBox" Margin="0,6,0,0" Height="30"/></StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,14,0,0">
                    <TextBlock Text="Marketplace" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,8,0"/>
                    <ComboBox x:Name="MarketplaceBox" Width="190" SelectedIndex="0">
                        <ComboBoxItem Content="United States" Tag="ATVPDKIKX0DER"/>
                        <ComboBoxItem Content="Canada" Tag="A2EUQ1WTGCTBG2"/>
                        <ComboBoxItem Content="Mexico" Tag="A1AM78C64UM0Y8"/>
                    </ComboBox>
                    <TextBlock Text="Analysis timezone" VerticalAlignment="Center" FontWeight="SemiBold" Margin="18,0,8,0"/>
                    <ComboBox x:Name="TimeZoneBox" Width="190" SelectedIndex="0">
                        <ComboBoxItem Content="US Pacific" Tag="Pacific Standard Time"/>
                        <ComboBoxItem Content="US Eastern" Tag="Eastern Standard Time"/>
                        <ComboBoxItem Content="US Central" Tag="Central Standard Time"/>
                        <ComboBoxItem Content="US Mountain" Tag="Mountain Standard Time"/>
                        <ComboBoxItem Content="UTC" Tag="UTC"/>
                    </ComboBox>
                    <Button x:Name="ConnectButton" Content="Test connection" Width="150" Height="34" Margin="18,0,0,0" Click="ConnectButton_Click"/>
                    <Button x:Name="CollectButton" Content="Collect analysis pack" Width="190" Height="34" Margin="10,0,0,0" Click="CollectButton_Click"/>
                </StackPanel>
                <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" x:Name="DataFolderText" Text="Analysis packs are saved under %LOCALAPPDATA%\WALKA.Analyzer\Data" Foreground="DimGray" Margin="0,10,0,0" TextWrapping="Wrap"/>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="0,0,0,14">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
            <Border BorderBrush="#D7DCE2" BorderThickness="1" CornerRadius="8" Padding="11" Margin="0,0,8,0"><StackPanel><TextBlock Text="Connection" Foreground="DimGray"/><TextBlock x:Name="ConnectionValue" Text="Not tested" FontSize="18" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel></Border>
            <Border Grid.Column="1" BorderBrush="#D7DCE2" BorderThickness="1" CornerRadius="8" Padding="11" Margin="0,0,8,0"><StackPanel><TextBlock Text="Orders · 7 days" Foreground="DimGray"/><TextBlock x:Name="OrdersValue" Text="—" FontSize="18" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel></Border>
            <Border Grid.Column="2" BorderBrush="#D7DCE2" BorderThickness="1" CornerRadius="8" Padding="11" Margin="0,0,8,0"><StackPanel><TextBlock Text="Sales · 7 days" Foreground="DimGray"/><TextBlock x:Name="SalesValue" Text="—" FontSize="18" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel></Border>
            <Border Grid.Column="3" BorderBrush="#D7DCE2" BorderThickness="1" CornerRadius="8" Padding="11" Margin="0,0,8,0"><StackPanel><TextBlock Text="FBA fulfillable" Foreground="DimGray"/><TextBlock x:Name="InventoryValue" Text="—" FontSize="18" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel></Border>
            <Border Grid.Column="4" BorderBrush="#D7DCE2" BorderThickness="1" CornerRadius="8" Padding="11" Margin="0,0,8,0"><StackPanel><TextBlock Text="Returns · 30 days" Foreground="DimGray"/><TextBlock x:Name="ReturnsValue" Text="—" FontSize="18" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel></Border>
            <Border Grid.Column="5" BorderBrush="#D7DCE2" BorderThickness="1" CornerRadius="8" Padding="11"><StackPanel><TextBlock Text="Best sales hour" Foreground="DimGray"/><TextBlock x:Name="BestHourValue" Text="—" FontSize="18" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel></Border>
        </Grid>

        <TabControl Grid.Row="3">
            <TabItem Header="Best Hours"><DataGrid x:Name="HoursGrid" IsReadOnly="True" AutoGenerateColumns="True" Margin="6"/></TabItem>
            <TabItem Header="Orders · 30d"><DataGrid x:Name="OrdersGrid" IsReadOnly="True" AutoGenerateColumns="True" Margin="6"/></TabItem>
            <TabItem Header="Returns · 30d"><DataGrid x:Name="ReturnsGrid" IsReadOnly="True" AutoGenerateColumns="True" Margin="6"/></TabItem>
            <TabItem Header="Price Snapshot"><DataGrid x:Name="PricesGrid" IsReadOnly="True" AutoGenerateColumns="True" Margin="6"/></TabItem>
            <TabItem Header="FBA Inventory"><DataGrid x:Name="InventoryGrid" IsReadOnly="True" AutoGenerateColumns="True" Margin="6"/></TabItem>
            <TabItem Header="Marketplaces"><DataGrid x:Name="MarketplacesGrid" IsReadOnly="True" AutoGenerateColumns="True" Margin="6"/></TabItem>
            <TabItem Header="Log"><TextBox x:Name="LogBox" IsReadOnly="True" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" Margin="6" FontFamily="Consolas"/></TabItem>
        </TabControl>

        <TextBlock Grid.Row="4" Text="Read-only collector. No campaign, listing, price, or inventory changes are made by this build." Foreground="DimGray" Margin="0,12,0,0"/>
    </Grid>
</Window>
