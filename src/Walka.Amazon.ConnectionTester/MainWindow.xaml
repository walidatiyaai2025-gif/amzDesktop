<Window x:Class="Walka.Amazon.ConnectionTester.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WALKA Amazon Analyzer" Height="900" Width="1540" MinHeight="760" MinWidth="1240"
        WindowStartupLocation="CenterScreen" Loaded="Window_Loaded">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="WALKA Amazon Analyzer" FontSize="27" FontWeight="SemiBold"/>
            <TextBlock Text="SP-API + cumulative offline SQLite history · Marketplace time + Kuwait time · Ads bridge ready" Foreground="DimGray" Margin="0,4,0,0"/>
        </StackPanel>

        <Border Grid.Row="1" BorderBrush="#D7DCE2" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                    <TextBlock Text="LWA Client ID" FontWeight="SemiBold"/>
                    <TextBox x:Name="ClientIdBox" Margin="0,5,0,0" Height="30"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,10,0">
                    <TextBlock Text="LWA Client Secret" FontWeight="SemiBold"/>
                    <PasswordBox x:Name="ClientSecretBox" Margin="0,5,0,0" Height="30"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Refresh Token" FontWeight="SemiBold"/>
                    <PasswordBox x:Name="RefreshTokenBox" Margin="0,5,0,0" Height="30"/>
                </StackPanel>

                <WrapPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,12,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Marketplace" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,7,0"/>
                    <ComboBox x:Name="MarketplaceBox" Width="155" SelectedIndex="0" Margin="0,0,14,0">
                        <ComboBoxItem Content="United States" Tag="ATVPDKIKX0DER"/>
                        <ComboBoxItem Content="Canada" Tag="A2EUQ1WTGCTBG2"/>
                        <ComboBoxItem Content="Mexico" Tag="A1AM78C64UM0Y8"/>
                    </ComboBox>
                    <TextBlock Text="Marketplace timezone" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,7,0"/>
                    <ComboBox x:Name="TimeZoneBox" Width="160" SelectedIndex="0" Margin="0,0,14,0">
                        <ComboBoxItem Content="US Pacific" Tag="Pacific Standard Time"/>
                        <ComboBoxItem Content="US Eastern" Tag="Eastern Standard Time"/>
                        <ComboBoxItem Content="US Central" Tag="Central Standard Time"/>
                        <ComboBoxItem Content="US Mountain" Tag="Mountain Standard Time"/>
                        <ComboBoxItem Content="UTC" Tag="UTC"/>
                    </ComboBox>
                    <Button x:Name="ConnectButton" Content="Test connection" Width="135" Height="32" Margin="0,0,8,0" Click="ConnectButton_Click"/>
                    <Button x:Name="CollectButton" Content="Collect latest pack" Width="145" Height="32" Margin="0,0,8,0" Click="CollectButton_Click"/>
                    <TextBlock Text="Backfill days" VerticalAlignment="Center" Margin="4,0,6,0"/>
                    <TextBox x:Name="BackfillDaysBox" Text="729" Width="55" Height="30" Margin="0,0,8,0" VerticalContentAlignment="Center"/>
                    <Button x:Name="BackfillButton" Content="Backfill history" Width="135" Height="32" Margin="0,0,8,0" Click="BackfillButton_Click"/>
                    <Button x:Name="CancelButton" Content="Cancel" Width="80" Height="32" IsEnabled="False" Click="CancelButton_Click"/>
                </WrapPanel>

                <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" x:Name="DataFolderText"
                           Text="Database: %LOCALAPPDATA%\WALKA.Analyzer\Data\walka-history.db"
                           Foreground="DimGray" Margin="0,9,0,0" TextWrapping="Wrap"/>
            </Grid>
        </Border>

        <Border Grid.Row="2" BorderBrush="#D7DCE2" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,10">
            <WrapPanel VerticalAlignment="Center">
                <TextBlock Text="Offline filter" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock Text="From" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <DatePicker x:Name="FromDatePicker" Width="125" Margin="0,0,8,0"/>
                <TextBlock Text="To" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <DatePicker x:Name="ToDatePicker" Width="125" Margin="0,0,8,0"/>
                <TextBlock Text="Hours" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <ComboBox x:Name="FromHourBox" Width="78" Margin="0,0,4,0" DisplayMemberPath="Label" SelectedValuePath="Hour"/>
                <TextBlock Text="→" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <ComboBox x:Name="ToHourBox" Width="78" Margin="0,0,10,0" DisplayMemberPath="Label" SelectedValuePath="Hour"/>
                <TextBlock Text="SKU" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <TextBox x:Name="SkuFilterBox" Width="120" Height="28" Margin="0,0,8,0"/>
                <TextBlock Text="ASIN" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <TextBox x:Name="AsinFilterBox" Width="120" Height="28" Margin="0,0,10,0"/>
                <Button x:Name="LoadOfflineButton" Content="Load offline analysis" Width="145" Height="30" Margin="0,0,8,0" Click="LoadOfflineButton_Click"/>
                <Button x:Name="ImportAdsButton" Content="Import Amazon Ads CSV" Width="155" Height="30" Margin="0,0,8,0" Click="ImportAdsButton_Click"/>
                <Button x:Name="ExportReportButton" Content="Export ChatGPT report" Width="150" Height="30" Click="ExportReportButton_Click"/>
            </WrapPanel>
        </Border>

        <Grid Grid.Row="3" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Border BorderBrush="#D7DCE2" BorderThickness="1" CornerRadius="8" Padding="9" Margin="0,0,6,0"><StackPanel><TextBlock Text="Connection" Foreground="DimGray"/><TextBlock x:Name="ConnectionValue" Text="Offline ready" FontSize="16" FontWeight="SemiBold" Margin="0,4,0,0" TextWrapping="Wrap"/></StackPanel></Border>
            <Border Grid.Column="1" BorderBrush="#D7DCE2" BorderThickness="1" CornerRadius="8" Padding="9" Margin="0,0,6,0"><StackPanel><TextBlock Text="DB coverage" Foreground="DimGray"/><TextBlock x:Name="CoverageValue" Text="—" FontSize="16" FontWeight="SemiBold" Margin="0,4,0,0" TextWrapping="Wrap"/></StackPanel></Border>
            <Border Grid.Column="2" BorderBrush="#D7DCE2" BorderThickness="1" CornerRadius="8" Padding="9" Margin="0,0,6,0"><StackPanel><TextBlock Text="Orders · 7d" Foreground="DimGray"/><TextBlock x:Name="OrdersValue" Text="—" FontSize="16" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel></Border>
            <Border Grid.Column="3" BorderBrush="#D7DCE2" BorderThickness="1" CornerRadius="8" Padding="9" Margin="0,0,6,0"><StackPanel><TextBlock Text="Sales · 7d" Foreground="DimGray"/><TextBlock x:Name="SalesValue" Text="—" FontSize="16" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel></Border>
            <Border Grid.Column="4" BorderBrush="#D7DCE2" BorderThickness="1" CornerRadius="8" Padding="9" Margin="0,0,6,0"><StackPanel><TextBlock Text="FBA fulfillable" Foreground="DimGray"/><TextBlock x:Name="InventoryValue" Text="—" FontSize="16" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel></Border>
            <Border Grid.Column="5" BorderBrush="#D7DCE2" BorderThickness="1" CornerRadius="8" Padding="9" Margin="0,0,6,0"><StackPanel><TextBlock Text="Returns · filter" Foreground="DimGray"/><TextBlock x:Name="ReturnsValue" Text="—" FontSize="16" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel></Border>
            <Border Grid.Column="6" BorderBrush="#D7DCE2" BorderThickness="1" CornerRadius="8" Padding="9"><StackPanel><TextBlock Text="Best hour · Market → Kuwait" Foreground="DimGray"/><TextBlock x:Name="BestHourValue" Text="—" FontSize="15" FontWeight="SemiBold" Margin="0,4,0,0" TextWrapping="Wrap"/></StackPanel></Border>
        </Grid>

        <TabControl Grid.Row="4">
            <TabItem Header="Best Hours"><DataGrid x:Name="HoursGrid" IsReadOnly="True" AutoGenerateColumns="True" Margin="6"/></TabItem>
            <TabItem Header="Hourly · Market + Kuwait"><DataGrid x:Name="HourlyGrid" IsReadOnly="True" AutoGenerateColumns="True" Margin="6"/></TabItem>
            <TabItem Header="Sales &amp; Traffic"><DataGrid x:Name="TrafficGrid" IsReadOnly="True" AutoGenerateColumns="True" Margin="6"/></TabItem>
            <TabItem Header="SKU Performance"><DataGrid x:Name="SkuGrid" IsReadOnly="True" AutoGenerateColumns="True" Margin="6"/></TabItem>
            <TabItem Header="Return Reasons"><DataGrid x:Name="ReturnsGrid" IsReadOnly="True" AutoGenerateColumns="True" Margin="6"/></TabItem>
            <TabItem Header="Price Response"><DataGrid x:Name="PricePerformanceGrid" IsReadOnly="True" AutoGenerateColumns="True" Margin="6"/></TabItem>
            <TabItem Header="Ads vs Sales"><DataGrid x:Name="AttributionGrid" IsReadOnly="True" AutoGenerateColumns="True" Margin="6"/></TabItem>
            <TabItem Header="FBA Inventory"><DataGrid x:Name="InventoryGrid" IsReadOnly="True" AutoGenerateColumns="True" Margin="6"/></TabItem>
            <TabItem Header="Marketplaces"><DataGrid x:Name="MarketplacesGrid" IsReadOnly="True" AutoGenerateColumns="True" Margin="6"/></TabItem>
            <TabItem Header="Log"><TextBox x:Name="LogBox" IsReadOnly="True" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap" Margin="6" FontFamily="Consolas"/></TabItem>
        </TabControl>

        <TextBlock Grid.Row="5" Text="Read-only Amazon collector. Data accumulates locally for offline analysis. Amazon Ads CSV can be imported now; direct Ads API connection will populate the same database later." Foreground="DimGray" Margin="0,9,0,0"/>
    </Grid>
</Window>
